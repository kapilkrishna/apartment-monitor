<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs monitor.py every 20 minutes on macOS.
  The install command in the README fills in __PYTHON__ and __DIR__.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.apartment-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__DIR__/monitor.py</string>
    </array>

    <key>StartInterval</key>
    <integer>1200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__DIR__/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/logs/launchd.log</string>
</dict>
</plist>

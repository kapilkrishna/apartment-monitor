# use this to set up push notifications to your phone 
# options : ntfy, pushover, and discord

# copy this to .env and fill in at least one. never commit .env.
# what to watch lives in config.toml.

# ntfy: free, no account. subscribe to a long random topic in the app,
# since anyone who knows the name can read it.
NTFY_TOPIC=

# pushover: user key from https://pushover.net, token from
# https://pushover.net/apps/build
PUSHOVER_USER=
PUSHOVER_TOKEN=

# discord: server settings → integrations → webhooks → new webhook
DISCORD_WEBHOOK_URL=
